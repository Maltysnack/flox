// A 100mm storm on day 1 forces a small reservoir past its threshold.
// Outflow switches from normalRate to openRate as storage fills, then
// back to normalRate as the storm drains away.
//
// Rates are absolute ML/day:
//   normalRate 5  = steady release while below threshold
//   openRate  30  = larger release once storage is at or above threshold
system Storm;

bigRain -> reservoir -> sea;

river  bigRain   { base: 5, peak: 10.0, decay: 0.5 }
dam    reservoir { capacity: 50, threshold: 80%, normalRate: 5, openRate: 30 }
outlet sea;

print Storm 100;
