// Devlins Creek catchment: two tributaries meeting Joes, then the outlet.
system Devlins;

Mahers -> Joes -> DevlinsCreek;
Bens   -> DevlinsCreek;

river Mahers { base: 2, peak: 5 }
river Joes   { base: 3, peak: 5 }
river Bens   { base: 1, peak: 1 }
outlet DevlinsCreek;

list Devlins;
map Devlins;
print Devlins;
