// PassOrShoot: a footballer on the edge of the box.
// Each "tick" the player either passes again (a quick one-two with a
// teammate) or pulls the trigger. Once the shot is taken, ~25% of those
// become goals; the rest miss. Goal and Miss are absorbing states, so
// running the chain long enough lets all the mass settle there.
//
// Markov chains are memoryless: the chance of shooting next doesn't
// depend on how many passes have already happened. So this model
// answers "what's my chance of eventually scoring?" but not "what's
// the optimal number of passes?". For the optimal-passes question see
// passes_buildup.flox (issue #25).
mode markov;
system PassOrShoot;

Pass  -[0.7]-> Pass;     // 70% chance of another pass
Pass  -[0.3]-> Shoot;    // 30% chance of shooting

Shoot -[0.25]-> Goal;
Shoot -[0.75]-> Miss;

// Absorbing: mass that arrives stays.
Goal -[1.0]-> Goal;
Miss -[1.0]-> Miss;

// Markov mode uses river/dam/outlet declarations as plain "state"
// containers. The numeric attributes are unused in markov mode but
// the declaration is still required so the resolver knows the name.
river Pass  { base: 0, peak: 0 }
river Shoot { base: 0, peak: 0 }
river Goal  { base: 0, peak: 0 }
river Miss  { base: 0, peak: 0 }

start Pass 1.0;

map  PassOrShoot;
print PassOrShoot 30;
