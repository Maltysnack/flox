system MurrayDarling;

UpperMurray[5, 3.0, 0.8] -> HumeDam{4500000, 75%, 0.85, 1.3} -> Murray[8, 2.5];

Murrumbidgee[4, 2.8, 0.75] -> BurrinjuckDam{1026000, 70%, 0.8, 1.2} -> MurrumbidgeeDownstream[3, 2.0];
MurrumbidgeeDownstream[3, 2.0] -> Murray[8, 2.5];

Darling[6, 3.5, 0.7] -> Murray[8, 2.5];

Murray[8, 2.5] -> LowerMurray[4, 1.5];
LowerMurray[4, 1.5] -> MurrayMouth[];

map MurrayDarling;
print MurrayDarling 5;
print MurrayDarling 15;
print MurrayDarling 30;
